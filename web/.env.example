# URL base de la API de Utama (incluye /api)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Modo de operación: mock | testnet
NEXT_PUBLIC_MODE=mock

# Publishable key de Pollar (Test mode). Si está vacía, Pollar no se monta.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=

# Token secreto SOLO del lado servidor para POST /demo-reset (nunca usar NEXT_PUBLIC_)
DEMO_RESET_TOKEN=
