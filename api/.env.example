DATABASE_URL="postgresql://utama:utama@localhost:5440/utama?schema=public"
PORT=3001
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001

# Modo de operación: mock (sin cadena) o testnet
ANTICRETICO_MODE=mock
DEMO_ESCALA=10000
PLAZO_INSCRIPCION_DIAS=30
# 1 = cancela automáticamente (cada 10 min) los contratos sin inscripción vencidos; apagado por defecto
VENCIMIENTOS_AUTO=0
RECONCILIAR_AUTO=0
RECONCILIAR_MIN=5
RECONCILIAR_MAX_INTENTOS=3
# 1 = una vez al día extiende el TTL on-chain de los folios atestados (H-04); apagado por defecto
TTL_AUTO=0
TTL_UMBRAL_LEDGERS=100000
TTL_EXTENDER_A=500000
COMISION_PCT=1
# Si se define, POST /api/demo/reset exige el header x-demo-token con este valor
DEMO_RESET_TOKEN=
TIPO_CAMBIO_BOB=
POLLAR_FONDEO_USDC=1

# --- Testnet (valores solo en el servidor; nunca versionar secretos) ---
STELLAR_NETWORK_PASSPHRASE=
STELLAR_RPC_URL=
STELLAR_HORIZON_URL=
FOLIOS_CONTRACT_ID=
# Fase 2 (F2-10): 1 = utama-folios (admin único, la demo); 2 = utama-folios-v2 (multifirma M de N)
FOLIOS_VERSION=1
# Solo con FOLIOS_VERSION=2: id del v2, firmas exigidas y secretos de los verificadores extra (umbral - 1)
FOLIOS_V2_CONTRACT_ID=
FOLIOS_UMBRAL=2
STELLAR_SECRET_VERIF_2=
STELLAR_SECRET_VERIF_3=
# Fase 2: pool de Vaquita en testnet (plan de devolución del dueño; opcional)
VAQUITA_CONTRACT_ID=CDKCKHTRKFJXVKLICHPIXAPLIVDRBDQEEGJYDKFOTUV35APVNOGTWZW7
ASSET_CODE=
ASSET_ISSUER=
ASSET_CONTRACT_ID=
# G... del TESORO (se derivará de STELLAR_SECRET_TESORO cuando exista el gateway testnet)
TESORO_ADDRESS=
TW_API_URL=
TW_API_KEY=
STELLAR_SECRET_VERIFICADOR=
STELLAR_SECRET_TESORO=
STELLAR_SECRET_ADMIN_TW=
STELLAR_SECRET_MEDIADOR=
STELLAR_SECRET_CARLOS=
STELLAR_SECRET_LUCIA=
STELLAR_SECRET_MARIA=
STELLAR_SECRET_DIEGO=
